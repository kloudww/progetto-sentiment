          },
          "expr": "sum by (tipo) (rate(sentiment_errori_predizione_total[1m]))",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{tipo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
